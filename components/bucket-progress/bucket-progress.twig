{#
/**
 * @file
 * Bucket list progress: count, a bar in province colours, a legend.
 *
 *   {{ include('townscanada:bucket-progress', {
 *     visited: 14, total: 52,
 *     provinces: [{code: 'on', name: 'Ontario', count: 9}, {code: 'ab', name: 'Alberta', count: 3}],
 *   }, false) }}
 */
#}
{% set denominator = max(total, 1) %}
{% set summary = provinces|map(p => p.name ~ ' ' ~ p.count)|join(', ') %}
<section{{ attributes.addClass('tc-progress').setAttribute('aria-labelledby', 'tc-progress-title') }}>
  <p class="tc-progress__eyebrow">{{ 'Your bucket list'|t }}</p>
  <h1 class="tc-progress__title" id="tc-progress-title">{{ '@visited of @total visited'|t({'@visited': visited, '@total': total}) }}</h1>
  <div class="tc-progress__bar" role="img" aria-label="{{ 'Visited by province: @list, out of @total'|t({'@list': summary, '@total': total}) }}">
    {% for p in provinces %}
      <span class="tc-progress__segment province-{{ p.code|lower|clean_class }}" style="width: {{ (p.count / denominator * 100)|round(1) }}%"></span>
    {% endfor %}
  </div>
  {% if provinces %}
    <ul class="tc-progress__legend">
      {% for p in provinces %}
        <li class="province-{{ p.code|lower|clean_class }}">
          <span class="tc-progress__dot" aria-hidden="true"></span>{{ p.name }} {{ p.count }}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</section>
