{#
/**
 * @file
 * Icon: the app's line icons, as drawn in the home screen design.
 *
 *   {{ include('townscanada:icon', {name: 'bookmark', size: 20}, false) }}
 */
#}
{% set s = size|default(24) %}
<svg class="tc-icon tc-icon--{{ name|clean_class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {% if name == 'home' %}
    <path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>
  {% elseif name == 'compass' %}
    <circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/>
  {% elseif name == 'map' %}
    <path d="M9 4L3 6v14l6-2 6 2 6-2V4l-6 2z"/><path d="M9 4v14M15 6v14"/>
  {% elseif name == 'bookmark' %}
    <path d="M6 3h12v18l-6-4-6 4z"/>
  {% elseif name == 'bookmark-add' %}
    <path d="M6 3h12v18l-6-4-6 4z"/><path d="M12 8v6M9 11h6"/>
  {% elseif name == 'check-circle' %}
    <circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>
  {% elseif name == 'check' %}
    <path d="M5 12l5 5 9-10"/>
  {% elseif name == 'pin' %}
    <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>
  {% elseif name == 'pin-check' %}
    <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><path d="M9 10l2 2 4-4"/>
  {% elseif name == 'search' %}
    <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
  {% elseif name == 'user' %}
    <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>
  {% elseif name == 'menu' %}
    <path d="M4 7h16M4 12h16M4 17h16"/>
  {% elseif name == 'close' %}
    <path d="M6 6l12 12M18 6L6 18"/>
  {% elseif name == 'cart' %}
    <circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2 3h3l2.5 12h11l2-8H6.5"/>
  {% elseif name == 'sign-out' %}
    <path d="M15 4h4v16h-4"/><path d="M10 8l-4 4 4 4M6 12h10"/>
  {% else %}
    <circle cx="12" cy="12" r="3"/>
  {% endif %}
</svg>
