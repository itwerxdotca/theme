{#
/**
 * @file
 * Trip card: next trip with numbered stops in province colours.
 */
#}
{% set heading_id = 'tc-trip-' ~ title|clean_id %}
<section{{ attributes.addClass('tc-trip').setAttribute('aria-labelledby', heading_id) }}>
  <div class="tc-trip__head">
    <div class="tc-trip__heading">
      {% if eyebrow %}
        <p class="tc-trip__eyebrow">{{ eyebrow }}</p>
      {% endif %}
      <h2 class="tc-trip__title" id="{{ heading_id }}">
        {% if url %}<a href="{{ url }}">{{ title }}</a>{% else %}{{ title }}{% endif %}
      </h2>
    </div>
    {% if start_url %}
      <a class="tc-trip__start" href="{{ start_url }}">{{ 'Start'|t }}</a>
    {% endif %}
  </div>
  {% if stops %}
    <ol class="tc-trip__stops">
      {% for stop in stops %}
        <li class="tc-trip__stop province-{{ stop.province_code|default('none')|lower|clean_class }}">
          <span class="tc-trip__number" aria-hidden="true">{{ loop.index }}</span>
          <span class="tc-trip__text">
            {% if stop.url %}
              <a class="tc-trip__name" href="{{ stop.url }}">{{ stop.name }}</a>
            {% else %}
              <span class="tc-trip__name">{{ stop.name }}</span>
            {% endif %}
            {% if stop.meta %}
              <span class="tc-trip__meta">{{ stop.meta }}</span>
            {% endif %}
          </span>
        </li>
      {% endfor %}
    </ol>
  {% endif %}
</section>
