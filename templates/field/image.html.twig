{#
/**
 * Temporary debug image template.
 *
 * Prints the image as usual and outputs an HTML comment with the
 * resolved src/srcset/sizes variables for diagnosis.
 *
 * Remove this debug template after troubleshooting.
 */
#}
<img{{ attributes }}
     {% if src is defined and src %} src="{{ src }}" {% endif %}
     {% if srcset is defined and srcset %} srcset="{{ srcset }}" {% endif %}
     {% if sizes is defined and sizes %} sizes="{{ sizes }}" {% endif %}
     alt="{{ alt|default('') }}"
     {% if title is defined and title %} title="{{ title }}" {% endif %}
     {% if width is defined and width %} width="{{ width }}" {% endif %}
     {% if height is defined and height %} height="{{ height }}" {% endif %} />
<!-- DEBUG_IMAGE_VARS src="{{ src|default('') }}" srcset="{{ srcset|default('') }}" sizes="{{ sizes|default('') }}" -->
