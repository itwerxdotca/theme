{# hierarchical-taxonomy-menu.html.twig #}

{# Get current path #}
{% set current_path = request.pathInfo %}
{% set path_parts = current_path|split('/') %}
{% set prefix = (path_parts|length >= 3) ? '/' ~ path_parts[1] ~ '/' ~ path_parts[2] : '' %}

{# Debug - remove after #}
<!-- DEBUG: Path: {{ current_path }} -->
<!-- DEBUG: Prefix: {{ prefix }} -->

{% macro menu_links(menu_tree, route_tid, current_depth, max_depth, collapsible, prefix) %}
  {% import _self as macros %}
  {% for item in menu_tree %}
    {%
      set liClass = [
        item.subitem and current_depth < max_depth ? 'menu-item menu-item--expanded dropdown' : 'menu-item',
        route_tid == item.tid ? 'menu-item--active' : '',
        current_depth == 0 ? 'nav-item' : 'dropdown-item-wrapper'
      ]
    %}
    <li class="{{ liClass|join(' ') }}">
      {% if item.subitem and current_depth < max_depth %}
        {% if current_depth == 0 %}
          {% set final_url = item.custom_url ?? item.url %}
          {% if prefix and not item.custom_url %}
            {% set final_url = prefix ~ final_url %}
          {% endif %}
          <a href="{{ final_url }}" class="nav-link dropdown-toggle {% if route_tid == item.tid %}active{% endif %}" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="{{ item.name }}">
            {% if item.field_listing_category_icon and item.field_listing_category_color %}
              {% set circle_color = item.field_listing_category_color|default('#999') %}
              {% set icon_class = item.field_listing_category_icon|default('la la-question') %}
              <div class="category-icon-wrapper">
                <svg class="category-icon-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="50" cy="50" r="50" fill="{{ circle_color }}" />
                </svg>
                <i class="{{ icon_class }} category-icon"></i>
              </div>
            {% endif %}
          </a>
        {% else %}
          {% set final_url = item.custom_url ?? item.url %}
          {% if prefix and not item.custom_url %}
            {% set final_url = prefix ~ final_url %}
          {% endif %}
          <a href="{{ final_url }}" class="dropdown-item dropdown-toggle {% if route_tid == item.tid %}active{% endif %}">
            {% if item.field_listing_category_icon and item.field_listing_category_color %}
              {% set circle_color = item.field_listing_category_color|default('#999') %}
              {% set icon_class = item.field_listing_category_icon|default('la la-question') %}
              <span class="category-icon-inline me-2">
                <svg class="category-icon-svg" width="20" height="20" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="50" cy="50" r="50" fill="{{ circle_color }}" />
                </svg>
                <i class="{{ icon_class }} category-icon" aria-hidden="true"></i>
              </span>
            {% endif %}
            {{ item.name }} <span class="referenced-entity-count">{% if item.show_count == true %}[{{ item.entities|length }}]{% endif %}</span>
          </a>
        {% endif %}
        <ul class="menu dropdown-menu dropdown-submenu {% if collapsible == TRUE %}collapsed-submenu{% endif %}">
          {{ macros.menu_links(item.subitem, route_tid, current_depth + 1, max_depth, collapsible, prefix) }}
        </ul>
      {% else %}
        {% if current_depth == 0 %}
          {% set final_url = item.custom_url ?? item.url %}
          {% if prefix and not item.custom_url and not final_url starts with prefix %}
            {% set final_url = prefix ~ final_url %}
          {% endif %}
          <a href="{{ final_url }}" class="nav-link {% if route_tid == item.tid %}active{% endif %}" title="{{ item.name }}">
            {% if item.field_listing_category_icon and item.field_listing_category_color %}
              {% set circle_color = item.field_listing_category_color|default('#999') %}
              {% set icon_class = item.field_listing_category_icon|default('la la-question') %}
              <div class="category-icon-wrapper">
                <svg class="category-icon-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="50" cy="50" r="50" fill="{{ circle_color }}" />
                </svg>
                <i class="{{ icon_class }} category-icon"></i>
              </div>
            {% endif %}
          </a>
        {% else %}
          {% set final_url = item.custom_url ?? item.url %}
          {% if prefix and not item.custom_url %}
            {% set final_url = prefix ~ final_url %}
          {% endif %}
          <a href="{{ final_url }}" class="dropdown-item {% if route_tid == item.tid %}active{% endif %}">
            {% if item.field_listing_category_icon and item.field_listing_category_color %}
              {% set circle_color = item.field_listing_category_color|default('#999') %}
              {% set icon_class = item.field_listing_category_icon|default('la la-question') %}
              <span class="category-icon-inline me-2">
                <svg class="category-icon-svg" width="20" height="20" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="50" cy="50" r="50" fill="{{ circle_color }}" />
                </svg>
                <i class="{{ icon_class }} category-icon" aria-hidden="true"></i>
              </span>
            {% endif %}
            {{ item.name }} <span class="referenced-entity-count">{% if item.show_count == true %}[{{ item.entities|length }}]{% endif %}</span>
          </a>
        {% endif %}
      {% endif %}
    </li>
  {% endfor %}
{% endmacro %}
{% import _self as macros %}
<ul class="menu hierarchical-taxonomy-menu nav">
  {{ macros.menu_links(menu_tree, route_tid, 0, max_depth, collapsible, prefix) }}
</ul>
