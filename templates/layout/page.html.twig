{# =======================================================
   Page template for townscanada theme
   ======================================================= #}

{# ==================== HEADER ==================== #}
{# Floating header: offcanvas menu trigger, branding, search and account. #}
<header class="site-header bg-white border-bottom shadow-sm fixed-top" role="banner">
  <nav class="navbar navbar-light bg-light">
    <div class="container-xl d-flex align-items-center py-2 w-100">

      {# Left: Hamburger menu trigger (offcanvas left) #}
      <button class="navbar-toggler me-2"
              type="button"
              data-bs-toggle="offcanvas"
              data-bs-target="#offcanvasLeft"
              aria-controls="offcanvasLeft"
              aria-label="{{ 'Open menu'|t }}">
        <span class="navbar-toggler-icon"></span>
      </button>

      {# Center: Site branding block #}
      <div class="flex-grow-1 d-flex justify-content-center">
        {{ drupal_block('system_branding_block') }}
      </div>

      {# Right: Search + Account #}
      <div class="d-flex align-items-center gap-2">

        {# Search modal trigger #}
        <button type="button"
                title="{{ 'Search Towns Canada'|t }}"
                class="btn btn-link text-dark p-0"
                data-bs-toggle="modal"
                data-bs-target="#searchModal"
                aria-label="{{ 'Search'|t }}">
          <i class="la la-search" aria-hidden="true"></i>
        </button>

        {# Account offcanvas/modal #}
        {% if logged_in %}

          <button type="button"
                  class="btn btn-link text-dark p-0"
                  data-bs-toggle="offcanvas"
                  data-bs-target="#offcanvasRight"
                  aria-controls="offcanvasRight"
                  aria-label="{{ 'Account menu'|t }}">
            <i class="la la-user" aria-hidden="true"></i>
          </button>

        {% else %}

          <button type="button"
                  title="{{ 'Login / Register at Towns Canada'|t }}"
                  class="btn btn-link text-dark p-0"
                  data-bs-toggle="modal"
                  data-bs-target="#loginModal"
                  aria-label="{{ 'Login / Register'|t }}">
            <i class="la la-user" aria-hidden="true"></i>
          </button>

        {% endif %}
        {# Shop: tablets and desktop only. On phones the app design puts the
           shop link in the left offcanvas region instead. #}
        <span class="border-start mx-1 align-self-stretch text-dark d-none d-md-block" aria-hidden="true"></span>
        <a href="https://shop.townscanada.ca"
           target="_blank"
           rel="noopener"
           title="{{ 'Shop Towns Canada (opens in a new tab)'|t }}"
           class="btn btn-link text-dark p-0 d-none d-md-inline-block"
           aria-label="{{ 'Shop Towns Canada (opens in a new tab)'|t }}">
          <i class="la la-shopping-cart" aria-hidden="true"></i>
        </a>
      </div>

    </div>
  </nav>

  {# Header region: blocks placed in "Header" in Block layout (e.g. an
     announcement bar). Sits inside the fixed header, so js/header-height.js
     includes it in the page offset automatically. #}
  {% if page.header %}
    <div class="container-xl">
      {{ page.header }}
    </div>
  {% endif %}
</header>

<main role="main">
  <a id="main-content" tabindex="-1"></a>

  {# Breadcrumb #}
  {% if page.breadcrumb %}
    <div class="container my-2">
      {{ page.breadcrumb }}
    </div>
  {% endif %}

  {# Layout for content and sidebars #}
  <div class="container {{ b5_top_container }}">
    <div class="row g-3">

      {# Sidebar first #}
      {% if page.sidebar_first %}
        <aside class="col-lg-3 order-lg-1">
          {{ page.sidebar_first }}
        </aside>
      {% endif %}

      {# Content #}
      <div class="{% if page.sidebar_first and page.sidebar_second %}col-lg-6{% elseif page.sidebar_first or page.sidebar_second %}col-lg-9{% else %}col-12{% endif %} order-lg-2">
        {# page--front.html.twig overrides this block to add the Discover
           screen's title and search box above the content. #}
        {% block main_content %}
          {{ page.content }}
        {% endblock %}
      </div>

      {# Sidebar second #}
      {% if page.sidebar_second %}
        <aside class="col-lg-3 order-lg-3">
          {{ page.sidebar_second }}
        </aside>
      {% endif %}
    </div>
  </div>
</main>

{# ==================== FOOTER ==================== #}
<footer role="contentinfo" class="bg-dark text-white py-4">
  <div class="container">

    {# Footer Top Regions (1–4) #}
    <div class="row text-center">
      {% for i in 1..4 %}
        {% set region_name = 'footer_' ~ i %}
        {% if attribute(page, region_name) %}
          <div class="col-12 col-md-3 mb-3 mb-md-0 d-flex justify-content-center">
            {{ attribute(page, region_name) }}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {# Footer Bottom Region #}
    {% if page.footer_bottom %}
      <div class="row mt-4">
        <div class="col-12 d-flex justify-content-center">
          {{ page.footer_bottom }}
        </div>
      </div>
    {% endif %}

  </div>
</footer>

{# ==================== APP TAB BAR (phones) ==================== #}
{# Bottom navigation from the "Mobile tabs" menu (machine name mobile-tabs),
   top level only. Prints nothing until that menu has links.
   Markup: templates/navigation/menu--mobile-tabs.html.twig. #}
{{ drupal_menu('mobile-tabs', 1, 1) }}

{# ==================== OFFCANVAS LEFT ==================== #}
<div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasLeft" aria-labelledby="offcanvasLeftLabel">
  <h2 class="visually-hidden" id="offcanvasLeftLabel">{{ 'Main menu'|t }}</h2>
  <div class="offcanvas-body">
    {% if page.offcanvas_left %}
      {{ page.offcanvas_left }}
    {% else %}
      {{ drupal_menu('main') }}
    {% endif %}
  </div>
</div>

{# ==================== OFFCANVAS RIGHT ==================== #}
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel">
  <h2 class="visually-hidden" id="offcanvasRightLabel">{{ 'Account'|t }}</h2>
  <div class="offcanvas-body">
    {% if page.offcanvas_right %}
      {{ page.offcanvas_right }}
    {% else %}
      {% if logged_in %}
        {{ drupal_menu('account') }}
      {% else %}
        <button type="button" class="btn btn-primary w-100"
                data-bs-toggle="modal"
                data-bs-target="#loginModal">{{ 'Login / Register'|t }}</button>
      {% endif %}
    {% endif %}
  </div>
</div>

{# ============================================================
   SEARCH MODAL
   ============================================================ #}

<div class="modal fade ajax-tab-modal"
     id="searchModal"
     tabindex="-1"
     aria-labelledby="searchModalLabel"
     aria-hidden="true">

  <div class="modal-dialog modal-dialog-centered">

    <div class="modal-content">

      <div class="modal-header border-0">

        <h2 class="modal-title h5" id="searchModalLabel">
          {{ 'Search'|t }}
        </h2>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="{{ 'Close'|t }}">
        </button>

      </div>

      <div class="modal-body">

        <ul class="nav nav-tabs"
            id="searchModalTabs"
            role="tablist">

          <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="search-tab-listings"
                    data-bs-toggle="tab"
                    data-bs-target="#search-pane-listings"
                    type="button"
                    role="tab"
                    aria-controls="search-pane-listings"
                    aria-selected="true">
              {{ 'Listings'|t }}
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="search-tab-poi"
                    data-bs-toggle="tab"
                    data-bs-target="#search-pane-poi"
                    type="button"
                    role="tab"
                    aria-controls="search-pane-poi"
                    aria-selected="false">
              {{ 'Points of Interest'|t }}
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="search-tab-stories"
                    data-bs-toggle="tab"
                    data-bs-target="#search-pane-stories"
                    type="button"
                    role="tab"
                    aria-controls="search-pane-stories"
                    aria-selected="false">
              {{ 'Stories'|t }}
            </button>
          </li>

        </ul>

        <div class="tab-content mt-3">

          {# Listings #}
          <div class="tab-pane fade show active"
               id="search-pane-listings"
               role="tabpanel"
               aria-labelledby="search-tab-listings"
               tabindex="0">

            {{ drupal_block('views_exposed_filter_block:listings_search-page_1', {
              label_display: false
            }) }}

          </div>

          {# Points of Interest #}
          <div class="tab-pane fade"
               id="search-pane-poi"
               role="tabpanel"
               aria-labelledby="search-tab-poi"
               tabindex="0">
          </div>

          {# Stories #}
          <div class="tab-pane fade"
               id="search-pane-stories"
               role="tabpanel"
               aria-labelledby="search-tab-stories"
               tabindex="0">

            {{ drupal_block('story_search_block') }}

          </div>

        </div>

      </div>

    </div>

  </div>

</div>


{# ============================================================
   LOGIN / REGISTER MODAL
   ============================================================ #}

<div class="modal fade ajax-tab-modal"
     id="loginModal"
     data-ajax-endpoint="modal/tclogin"
     tabindex="-1"
     aria-labelledby="loginModalLabel"
     aria-hidden="true">

  <div class="modal-dialog modal-dialog-centered">

    <div class="modal-content">

      <div class="modal-header border-0">

        <h2 class="modal-title h5" id="loginModalLabel">
          {{ 'Account Access'|t }}
        </h2>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="{{ 'Close'|t }}">
        </button>

      </div>

      <div class="modal-body">

        <ul class="nav nav-tabs"
            role="tablist">

          <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    data-bs-toggle="tab"
                    id="login-tab-login"
                    data-bs-target="#login"
                    type="button"
                    role="tab"
                    aria-controls="login"
                    aria-selected="true">
              {{ 'Login'|t }}
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link"
                    data-bs-toggle="tab"
                    id="login-tab-register"
                    data-bs-target="#register"
                    type="button"
                    role="tab"
                    aria-controls="register"
                    aria-selected="false">
              {{ 'Register'|t }}
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link"
                    data-bs-toggle="tab"
                    id="login-tab-password"
                    data-bs-target="#password"
                    type="button"
                    role="tab"
                    aria-controls="password"
                    aria-selected="false">
              {{ 'Forgot Password'|t }}
            </button>
          </li>

        </ul>

        <div class="tab-content mt-3">

          {# Login #}
          <div class="tab-pane fade show active"
               id="login"
               role="tabpanel"
               aria-labelledby="login-tab-login">

            <div class="ajax-form-loading text-center py-5">
              <div class="spinner-border" role="status">
                <span class="visually-hidden">{{ 'Loading…'|t }}</span>
              </div>
            </div>

          </div>

          {# Register #}
          <div class="tab-pane fade"
               id="register"
               role="tabpanel"
               aria-labelledby="login-tab-register">

            <div class="ajax-form-loading text-center py-5"></div>

          </div>

          {# Forgot Password #}
          <div class="tab-pane fade"
               id="password"
               role="tabpanel"
               aria-labelledby="login-tab-password">

            <div class="ajax-form-loading text-center py-5"></div>

          </div>

        </div>

      </div>

    </div>

  </div>

</div>
