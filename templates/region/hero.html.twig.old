{#
  Region: hero
  Conservative, non-destructive template:
  - Renders responsive image when available (hero_image_responsive).
  - Falls back to background-image when only hero_image_url is present.
  - Only outputs data-parallax and data-hero-fit when an image exists.
#}

{# Determine if we have an image (responsive render OR url) #}
{% set has_image = hero_image_responsive is not empty or hero_image_url is not empty %}

{# Parallax on only when image exists; speed defaulted to 0.18 #}
<div class="hero-region"
     {% if has_image %}data-parallax="true" data-parallax-speed="{{ hero_parallax_speed|default('0.18') }}"{% else %}data-parallax="false"{% endif %}
     {% if hero_fit %}data-hero-fit="scale"{% endif %}
     {% set bg_style = '' %}
     {% if hero_image_url and not hero_image_responsive %}
       {% set bg_style = "background-image: url('" ~ hero_image_url ~ "');" %}
     {% endif %}
     {% if hero_background_color %}
       {% set bg_style = bg_style ~ " background-color: " ~ hero_background_color ~ ";" %}
     {% endif %}
     {% if bg_style %} style="{{ bg_style }}"{% endif %}>

  <div class="hero-media" aria-hidden="{{ hero_image_caption ? 'false' : 'true' }}">
    {% if hero_image_responsive %}
      {{ hero_image_responsive }}
    {% endif %}
    {# If no responsive image, the background-image style on .hero-region is used. #}
  </div>

  <div class="hero-content">
    <div class="container text-center">
      {% if hero_meta.kicker %}
        <div class="hero-kicker">{{ hero_meta.kicker }}</div>
      {% endif %}

      <h1 class="title">{{ hero_title }}</h1>

      {% if hero_subtitle %}
        <p class="subtitle">{{ hero_subtitle }}</p>
      {% endif %}

      {% if hero_cta_url %}
        <p class="hero-cta">
          <a href="{{ hero_cta_url }}" class="btn btn-primary" rel="noopener">
            {{ hero_cta_title ?: 'Learn more' }}
          </a>
        </p>
      {% endif %}

      {% if hero_image_caption %}
        <div class="hero-caption">{{ hero_image_caption }}</div>
      {% endif %}

      {# Term badge preserved #}
      {% if term is defined and term.vocabulary == 'listing_category' %}
        <div class="hero-term">
          <div class="term-badge">
            {% set circle_color = term.field_listing_category_color|default('#999') %}
            {% set icon_class = term.field_listing_category_icon|default('la la-question') %}

            <div class="category-icon-wrapper">
              <svg class="category-icon-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <circle cx="50" cy="50" r="50" fill="{{ circle_color }}" />
              </svg>
              <i class="{{ icon_class }} category-icon"></i>
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  {# DOM overlay element (template-controlled) #}
  {% set overlay_opacity = hero_overlay_opacity ? hero_overlay_opacity : '0.35' %}
  <div class="hero-overlay" aria-hidden="true" style="background: rgba(0,0,0,{{ overlay_opacity }});"></div>
</div>
