{# Region: hero - Background image layer #}

{% set has_image = hero_image_responsive is not empty or hero_image_url is not empty %}

{# Parallax config (safe defaults if not provided by preprocess) #}
{% set parallax_enabled = has_image ? 'true' : 'false' %}
{% set parallax_speed = hero_parallax_speed|default('0.18') %}
{# Disable parallax below this width (px). Common choice: 992 for Bootstrap md/lg boundary. #}
{% set parallax_breakpoint = hero_parallax_breakpoint|default('992') %}
{# Clamp modes: 'up' (default, prevents downward gap), 'down', or 'none' #}
{% set parallax_clamp = hero_parallax_clamp|default('up') %}

<div class="hero-region"
     data-parallax="{{ parallax_enabled }}"
     {% if parallax_enabled == 'true' %}
       data-parallax-speed="{{ parallax_speed }}"
       data-parallax-breakpoint="{{ parallax_breakpoint }}"
       data-parallax-clamp="{{ parallax_clamp }}"
     {% endif %}
     {% if hero_fit %}data-hero-fit="scale"{% endif %}
     {% set bg_style = '' %}
     {% if hero_image_url and not hero_image_responsive %}
       {% set bg_style = "background-image: url('" ~ hero_image_url ~ "');" %}
     {% endif %}
     {% if hero_background_color %}
       {% set bg_style = bg_style ~ " background-color: " ~ hero_background_color ~ ";" %}
     {% endif %}
     {% if bg_style %} style="{{ bg_style }}"{% endif %}>

  <div class="hero-media" aria-hidden="true">
    {% if hero_image_responsive %}
      {{ hero_image_responsive }}
    {% endif %}
  </div>

  {# Foreground content - just render the blocks #}
  <div class="hero-content">
    {{ content }}
  </div>

  {% set overlay_opacity = hero_overlay_opacity|default('0.35') %}
  <div class="hero-overlay" aria-hidden="true" style="background: rgba(0,0,0,{{ overlay_opacity }});"></div>
</div>
