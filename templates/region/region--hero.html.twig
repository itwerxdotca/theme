{#
/**
 * @file
 * Hero region: background image layer, overlay and the region's blocks.
 *
 * Variables (set and validated in townscanada_preprocess_region()):
 * - hero_image_responsive: Render array for the background image, or NULL.
 * - hero_image_url: Fallback image URL when no render array is available.
 * - hero_background_color: A validated hex colour, or empty.
 * - hero_overlay_opacity: A number between 0 and 1.
 * - hero_parallax_speed: A number, read by js/parallax.js.
 * - hero_fit: TRUE to scale the image to fit (data-hero-fit="scale").
 *
 * Colours and the image URL are passed as CSS custom properties so no
 * editor-supplied value is written into a style declaration directly.
 */
#}
{% set has_image = hero_image_responsive is not empty or hero_image_url is not empty %}

{% set region_style = [] %}
{% if hero_background_color %}
  {% set region_style = region_style|merge(['--hero-bg: ' ~ hero_background_color]) %}
{% endif %}
{% set region_style = region_style|merge(['--hero-overlay-opacity: ' ~ hero_overlay_opacity|default(0.35)]) %}

<div class="hero-region"
     data-parallax="{{ has_image ? 'true' : 'false' }}"
     {% if has_image %}data-parallax-speed="{{ hero_parallax_speed|default(0.18) }}"{% endif %}
     {% if hero_fit %}data-hero-fit="scale"{% endif %}
     style="{{ region_style|join('; ') }}">

  <div class="hero-media" aria-hidden="true"
       {% if hero_image_url and not hero_image_responsive %}style="background-image: url('{{ hero_image_url }}');"{% endif %}>
    {{ hero_image_responsive }}
  </div>

  <div class="hero-content">
    {{ content }}
  </div>

  <div class="hero-overlay" aria-hidden="true"></div>
</div>
