<header class="site-header bg-white border-bottom shadow-sm fixed-top" role="banner">
  <nav class="navbar navbar-light bg-light">
    <div class="container-xl d-flex align-items-center py-2 w-100">

      {# Left: Hamburger menu trigger (offcanvas left) #}
      <button class="navbar-toggler me-2"
              type="button"
              data-bs-toggle="offcanvas"
              data-bs-target="#offcanvasLeft"
              aria-controls="offcanvasLeft"
              aria-label="{{ 'Open menu'|t }}">
        <span class="navbar-toggler-icon"></span>
      </button>

      {# Center: Site branding block #}
      <div class="flex-grow-1 d-flex justify-content-center">
        {{ drupal_block('system_branding_block') }}
      </div>

      {# Right: Search + Account #}
      <div class="d-flex align-items-center gap-2">

        {# Search modal trigger #}
        <button type="button"
                title="{{ 'Search Towns Canada'|t }}"
                class="btn btn-link text-dark p-0"
                data-bs-toggle="modal"
                data-bs-target="#searchModal"
                aria-label="{{ 'Search'|t }}">
          <i class="la la-search" aria-hidden="true"></i>
        </button>

        {# Account offcanvas/modal #}
        {% if logged_in %}

          <button type="button"
                  class="btn btn-link text-dark p-0"
                  data-bs-toggle="offcanvas"
                  data-bs-target="#offcanvasRight"
                  aria-controls="offcanvasRight"
                  aria-label="{{ 'Account menu'|t }}">
            <i class="la la-user" aria-hidden="true"></i>
          </button>

        {% else %}

          <button type="button"
                  title="{{ 'Login / Register at Towns Canada'|t }}"
                  class="btn btn-link text-dark p-0"
                  data-bs-toggle="modal"
                  data-bs-target="#loginModal"
                  aria-label="{{ 'Login / Register'|t }}">
            <i class="la la-user" aria-hidden="true"></i>
          </button>

        {% endif %}
        <span class="border-start mx-1 align-self-stretch text-dark" aria-hidden="true"></span>
        {# Shop #}
        <a href="https://shop.townscanada.ca"
           target="_blank"
           rel="noopener"
           title="{{ 'Shop Towns Canada (opens in a new tab)'|t }}"
           class="btn btn-link text-dark p-0"
           aria-label="{{ 'Shop Towns Canada (opens in a new tab)'|t }}">
          <i class="la la-shopping-cart" aria-hidden="true"></i>
        </a>
      </div>

    </div>
  </nav>
</header>


{# ============================================================
   SEARCH MODAL
   ============================================================ #}

<div class="modal fade ajax-tab-modal"
     id="searchModal"
     tabindex="-1"
     aria-labelledby="searchModalLabel"
     aria-hidden="true">

  <div class="modal-dialog modal-dialog-centered">

    <div class="modal-content">

      <div class="modal-header border-0">

        <h2 class="modal-title h5" id="searchModalLabel">
          {{ 'Search'|t }}
        </h2>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="{{ 'Close'|t }}">
        </button>

      </div>

      <div class="modal-body">

        <ul class="nav nav-tabs"
            id="searchModalTabs"
            role="tablist">

          <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="search-tab-listings"
                    data-bs-toggle="tab"
                    data-bs-target="#search-pane-listings"
                    type="button"
                    role="tab"
                    aria-controls="search-pane-listings"
                    aria-selected="true">
              {{ 'Listings'|t }}
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="search-tab-poi"
                    data-bs-toggle="tab"
                    data-bs-target="#search-pane-poi"
                    type="button"
                    role="tab"
                    aria-controls="search-pane-poi"
                    aria-selected="false">
              {{ 'Points of Interest'|t }}
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="search-tab-stories"
                    data-bs-toggle="tab"
                    data-bs-target="#search-pane-stories"
                    type="button"
                    role="tab"
                    aria-controls="search-pane-stories"
                    aria-selected="false">
              {{ 'Stories'|t }}
            </button>
          </li>

        </ul>

        <div class="tab-content mt-3">

          {# Listings #}
          <div class="tab-pane fade show active"
               id="search-pane-listings"
               role="tabpanel"
               aria-labelledby="search-tab-listings"
               tabindex="0">

            {{ drupal_block('views_exposed_filter_block:listings_search-page_1', {
              label_display: false
            }) }}

          </div>

          {# Points of Interest #}
          <div class="tab-pane fade"
               id="search-pane-poi"
               role="tabpanel"
               aria-labelledby="search-tab-poi"
               tabindex="0">
          </div>

          {# Stories #}
          <div class="tab-pane fade"
               id="search-pane-stories"
               role="tabpanel"
               aria-labelledby="search-tab-stories"
               tabindex="0">

            {{ drupal_block('story_search_block') }}

          </div>

        </div>

      </div>

    </div>

  </div>

</div>


{# ============================================================
   LOGIN / REGISTER MODAL
   ============================================================ #}

<div class="modal fade ajax-tab-modal"
     id="loginModal"
     data-ajax-endpoint="modal/tclogin"
     tabindex="-1"
     aria-labelledby="loginModalLabel"
     aria-hidden="true">

  <div class="modal-dialog modal-dialog-centered">

    <div class="modal-content">

      <div class="modal-header border-0">

        <h2 class="modal-title h5" id="loginModalLabel">
          {{ 'Account Access'|t }}
        </h2>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="{{ 'Close'|t }}">
        </button>

      </div>

      <div class="modal-body">

        <ul class="nav nav-tabs"
            role="tablist">

          <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    data-bs-toggle="tab"
                    id="login-tab-login"
                    data-bs-target="#login"
                    type="button"
                    role="tab"
                    aria-controls="login"
                    aria-selected="true">
              {{ 'Login'|t }}
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link"
                    data-bs-toggle="tab"
                    id="login-tab-register"
                    data-bs-target="#register"
                    type="button"
                    role="tab"
                    aria-controls="register"
                    aria-selected="false">
              {{ 'Register'|t }}
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link"
                    data-bs-toggle="tab"
                    id="login-tab-password"
                    data-bs-target="#password"
                    type="button"
                    role="tab"
                    aria-controls="password"
                    aria-selected="false">
              {{ 'Forgot Password'|t }}
            </button>
          </li>

        </ul>

        <div class="tab-content mt-3">

          {# Login #}
          <div class="tab-pane fade show active"
               id="login"
               role="tabpanel"
               aria-labelledby="login-tab-login">

            <div class="ajax-form-loading text-center py-5">
              <div class="spinner-border" role="status">
                <span class="visually-hidden">{{ 'Loading…'|t }}</span>
              </div>
            </div>

          </div>

          {# Register #}
          <div class="tab-pane fade"
               id="register"
               role="tabpanel"
               aria-labelledby="login-tab-register">

            <div class="ajax-form-loading text-center py-5"></div>

          </div>

          {# Forgot Password #}
          <div class="tab-pane fade"
               id="password"
               role="tabpanel"
               aria-labelledby="login-tab-password">

            <div class="ajax-form-loading text-center py-5"></div>

          </div>

        </div>

      </div>

    </div>

  </div>

</div>
