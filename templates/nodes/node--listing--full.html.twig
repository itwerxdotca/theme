{#
/**
 * @file
 * node--listing--full.html.twig
 *
 * Full view mode for listing nodes. Renders a Bootstrap accordion containing:
 *  - About (open)
 *  - Amenities (paragraph bundle listing_amenities) — only shown when paragraph has content
 *  - Reviews (closed) — comment form rendered inside accordion
 *
 * Notes:
 *  - Renders paragraphs with Twig Tweak using drupal_entity('paragraph', id)
 *  - This template intentionally suppresses the node's comment/comment(s) render
 *    in the main content area and prints it explicitly inside the Reviews panel.
 *  - After installing this file, clear caches (drush cr).
 */
#}

{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.bundle|clean_class,
    not node.isPublished() ? 'is-unpublished',
    view_mode ? view_mode|clean_class,
  ]
%}

<article{{ attributes.addClass(classes) }}>
  <div class="container">
    <div class="row">
      <div class="content col-12">

        {# Render main node content but suppress fields we will render inside the accordion.
           Important: exclude both singular 'comment' and plural 'comments' keys so the
           comment form/list does not print at the top of the node. #}
           {{ content|without(
             'body',
             'field_description',
             'field_listing_components',
             'comment',
             'comments',
             'field_hero_image',
             'field_listing_address',
             'field_listing_category',
             'field_listing_phone',
             'field_listing_website',
             'langcode',
             'group_local_impact_score',
             'field_listing_tags',
             'field_location_vocabulary'
           ) }}

        {#
          Compute presence flags.
          - has_description: body or field_description content present
          - has_amenities: at least one listing_amenities paragraph with description or list
        #}
        {% set has_description = (content['body'] is defined and content.body) or (content['field_description'] is defined and content.field_description) %}

        {% set has_amenities = false %}
        {% if node.hasField('field_listing_components') %}
          {% for item in node.field_listing_components %}
            {% if not has_amenities %}
              {% set p = item.entity %}
              {% if p and p.bundle() == 'listing_amenities' %}
                {% set has_desc = p.hasField('field_listing_amenities_description') and not p.get('field_listing_amenities_description').isEmpty() %}
                {% set has_list = p.hasField('field_listing_amenities') and not p.get('field_listing_amenities').isEmpty() %}
                {% if has_desc or has_list %}
                  {% set has_amenities = true %}
                {% endif %}
              {% endif %}
            {% endif %}
          {% endfor %}
        {% endif %}

        {# Keep reviews panel visible; we'll render form/list inside if present. #}
        {% set has_reviews = true %}

        {% if has_description or has_amenities or has_reviews %}
          {% set accordion_id = 'listing-accordion-' ~ node.id() %}
          <div class="listing-accordion mt-4">
            <div class="accordion" id="{{ accordion_id }}">

              {# ---------- About panel (OPEN) ---------- #}
              {% if has_description %}
                <div class="accordion-item">
                  <h2 class="accordion-header" id="heading-about-{{ node.id() }}">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-about-{{ node.id() }}" aria-expanded="true" aria-controls="collapse-about-{{ node.id() }}">
                      About {{ node.label() }}
                    </button>
                  </h2>
                  <div id="collapse-about-{{ node.id() }}" class="accordion-collapse collapse show" aria-labelledby="heading-about-{{ node.id() }}" data-bs-parent="#{{ accordion_id }}">
                    <div class="accordion-body">
                      {% if content['body'] is defined and content.body %}
                        {{ content.body }}
                      {% elseif content['field_description'] is defined and content.field_description %}
                        {{ content.field_description }}
                      {% else %}
                        {{ node.label() }}
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endif %}

              {# ---------- Amenities panel (CLOSED) - show only when there is content ---------- #}
              {% if has_amenities %}
                <div class="accordion-item">
                  <h2 class="accordion-header" id="heading-amenities-{{ node.id() }}">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-amenities-{{ node.id() }}" aria-expanded="false" aria-controls="collapse-amenities-{{ node.id() }}">
                      {{ node.label() }} Amenities
                    </button>
                  </h2>

                  <div id="collapse-amenities-{{ node.id() }}" class="accordion-collapse collapse" aria-labelledby="heading-amenities-{{ node.id() }}" data-bs-parent="#{{ accordion_id }}">
                    <div class="accordion-body">
                      {% set any_rendered = false %}
                      {% if node.hasField('field_listing_components') %}
                        {% for item in node.field_listing_components %}
                          {% set p = item.entity %}
                          {% if p and p.bundle() == 'listing_amenities' %}
                            {% set has_desc = p.hasField('field_listing_amenities_description') and not p.get('field_listing_amenities_description').isEmpty() %}
                            {% set has_list = p.hasField('field_listing_amenities') and not p.get('field_listing_amenities').isEmpty() %}
                            {% if has_desc or has_list %}
                              {{ drupal_entity('paragraph', p.id()) }}
                              {% set any_rendered = true %}
                            {% endif %}
                          {% endif %}
                        {% endfor %}
                      {% endif %}

                      {% if not any_rendered %}
                        <p class="mb-0">No amenities listed.</p>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endif %}

              {# ---------- Reviews panel (CLOSED) - comment form placed here ---------- #}
              <div class="accordion-item">
                <h2 class="accordion-header" id="heading-reviews-{{ node.id() }}">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-reviews-{{ node.id() }}" aria-expanded="false" aria-controls="collapse-reviews-{{ node.id() }}">
                    Reviews For {{ node.label() }}
                  </button>
                </h2>

                <div id="collapse-reviews-{{ node.id() }}" class="accordion-collapse collapse" aria-labelledby="heading-reviews-{{ node.id() }}" data-bs-parent="#{{ accordion_id }}">
                  <div class="accordion-body" id="reviews-{{ node.id() }}">

                    {% if logged_in %}
                      {# Most common shape: comment form under content.comments['comment_form'] #}
                      {% if content.comments is defined and content.comments %}
                        {% if content.comments['comment_form'] is defined %}
                          {{ content.comments['comment_form'] }}
                        {% endif %}

                        {# Then render comments list if present, otherwise render remaining content.comments #}
                        {% if content.comments['comments'] is defined %}
                          {{ content.comments['comments'] }}
                        {% else %}
                          {{ content.comments }}
                        {% endif %}

                      {# Alternate common shape: form/list attached under content.comment #}
                      {% elseif content.comment is defined %}
                        {{ content.comment }}

                      {# Rare alternate: top-level content.comment_form #}
                      {% elseif content.comment_form is defined %}
                        {{ content.comment_form }}

                      {# Nothing attached — fallback message #}
                      {% else %}
                        <p class="mb-0">No reviews yet. Be the first to leave one!</p>
                      {% endif %}

                    {% else %}
                      <div class="text-center py-4">
                        <p class="mb-3 lead">Login to leave a review!</p>
                        <div class="d-flex justify-content-center gap-2">
                          <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#loginModal">
                            Log in
                          </button>
                        </div>
                      </div>
                    {% endif %}

                  </div>
                </div>
              </div>

            </div> {# .accordion #}
          </div> {# .listing-accordion #}
        {% endif %}
      </div>
    </div>
  </div>
</article>
