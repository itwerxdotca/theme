{#
/**
 * @file
 * A tag (tags term). On the tag's own page (full view) the name is the H1,
 * with the site-wide .tc-page-title class. The content with the tag comes
 * from the "Tagged: ..." blocks (tc_tagged_content view) placed in Block
 * layout. In other views (lists, teasers) the name is a linked heading.
 */
#}
<div{{ attributes.addClass('taxonomy-term', 'vocabulary-tags', 'tc-tag') }}>
  {{ title_prefix }}
  {% if view_mode == 'full' %}
    <h1{{ title_attributes.addClass('tc-page-title') }}>{{ name }}</h1>
  {% else %}
    <h2{{ title_attributes }}><a href="{{ url }}">{{ name }}</a></h2>
  {% endif %}
  {{ title_suffix }}
  {{ content }}
</div>
