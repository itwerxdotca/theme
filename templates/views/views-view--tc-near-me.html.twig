{#
/**
 * @file
 * The "tc_near_me" View (Near me page): page_1 = listings, attachment_1 =
 * points of interest.
 *
 * Same as views-view.html.twig. With results, the place rows and their
 * heading come from views-view-unformatted--tc-place-list.html.twig. With
 * none, the same heading over "No ... within 50 km yet.", then an "Add"
 * button for logged-in users or a button opening the login modal for
 * visitors (page.html.twig, #loginModal). Views picks this template by its
 * name (views-view--<view id>), for both displays.
 */
#}
{% set poi = display_id == 'attachment_1' %}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {% if header %}
    <div class="view-header">
      {{ header }}
    </div>
  {% endif %}
  {% if attachment_before %}
    <div class="attachment attachment-before">
      {{ attachment_before }}
    </div>
  {% endif %}

  {% if rows %}
    <div class="view-content">
      {{ rows }}
    </div>
  {% else %}
    {% embed 'townscanada:section' with {
      heading: poi ? 'Points of interest near you'|t : 'Places near you'|t,
      heading_id: 'tc-near-me-empty-' ~ display_id|clean_class,
      poi: poi,
      logged_in: logged_in,
    } only %}
      {% block content %}
        <p class="title">{{ poi ? 'No points of interest within 50 km yet.'|t : 'No listings within 50 km yet.'|t }}</p>
        {% if logged_in %}
          <p class="title"><a href="{{ path('node.add', {'node_type': poi ? 'point_of_interest' : 'listing'}) }}" class="btn btn-primary">{{ poi ? 'Add Point of Interest'|t : 'Add Listing'|t }}</a></p>
        {% else %}
          <p class="title"><button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#loginModal">{{ poi ? 'Log in to add a point of interest'|t : 'Log in to add a listing'|t }}</button></p>
        {% endif %}
      {% endblock %}
    {% endembed %}
  {% endif %}

  {% if pager %}
    {{ pager }}
  {% endif %}
  {% if attachment_after %}
    <div class="attachment attachment-after">
      {{ attachment_after }}
    </div>
  {% endif %}
</div>
