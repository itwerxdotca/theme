<?php

/**
 * @file
 * Theme functions for the Towns Canada theme.
 *
 * Hero: the background image for the hero region is worked out once, in
 * townscanada_preprocess_region(), and rendered by region--hero.html.twig.
 */

use Drupal\block_content\BlockContentInterface;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\file\FileInterface;
use Drupal\image\Entity\ImageStyle;
use Drupal\media\MediaInterface;
use Drupal\node\NodeInterface;
use Drupal\taxonomy\TermInterface;

/**
 * Image style used for hero background URLs.
 */
const TOWNSCANADA_HERO_IMAGE_STYLE = 'blog_1140x642_';

/**
 * Responsive image style used for hero images.
 */
const TOWNSCANADA_HERO_RESPONSIVE_STYLE = 'hero_responsive';

/**
 * Node fields checked, in order, for the hero image.
 */
const TOWNSCANADA_HERO_NODE_FIELDS = [
  'field_hero_image',
  'field_hero_media',
  'field_image',
  'field_listing_image',
  'field_media',
];

/**
 * Taxonomy term fields checked, in order, for the hero image.
 */
const TOWNSCANADA_HERO_TERM_FIELDS = [
  'field_listing_location_image',
  'field_listing_category_image',
];

/**
 * Returns an absolute URL for a file URI, or '' on failure.
 */
function townscanada_file_url(string $uri): string {
  if ($uri === '') {
    return '';
  }
  try {
    return \Drupal::service('file_url_generator')->generateAbsoluteString($uri);
  }
  catch (\Throwable $e) {
    return '';
  }
}

/**
 * Returns an image-style URL for a file URI, falling back to the file URL.
 */
function _townscanada_image_style_url(string $uri, string $image_style = TOWNSCANADA_HERO_IMAGE_STYLE): string {
  $style = ImageStyle::load($image_style);
  if ($style) {
    try {
      return $style->buildUrl($uri);
    }
    catch (\Throwable $e) {
      // Fall through to the plain file URL.
    }
  }
  return townscanada_file_url($uri);
}

/**
 * Implements hook_preprocess_page().
 */
function townscanada_preprocess_page(array &$variables) {
  // page.html.twig prints these regions unconditionally.
  foreach (['nav_branding', 'nav_main', 'nav_additional', 'hero'] as $region) {
    $variables['page'][$region] ??= [];
  }

  // The login/register modal is only needed by anonymous users, so the page
  // must be cached separately for them.
  $variables['#cache']['contexts'][] = 'user.roles:anonymous';
  if (\Drupal::currentUser()->isAnonymous()) {
    $variables['#attached']['library'][] = 'townscanada/modal-forms';
  }
}

/**
 * Extracts an image and its metadata from an image or media field.
 *
 * @param \Drupal\Core\Entity\FieldableEntityInterface $entity
 *   The entity holding the field.
 * @param string $field_name
 *   The field to read: an image field, or a reference to a Media entity.
 *
 * @return array|null
 *   NULL when there is no viewable image, otherwise an array with:
 *   - url: An image-style URL.
 *   - responsive_render: A render array for the image.
 *   - alt, title, caption: Strings.
 *   - cache_tags: Cache tags for the file and media.
 */
function _townscanada_extract_image_from_field(FieldableEntityInterface $entity, string $field_name): ?array {
  if (!$entity->hasField($field_name) || $entity->get($field_name)->isEmpty()) {
    return NULL;
  }

  $item = $entity->get($field_name)->first();
  $ref = $item->entity ?? NULL;
  $file = NULL;
  $alt = '';
  $title = '';
  $caption = '';
  $cache_tags = [];

  if ($ref instanceof MediaInterface) {
    $cache_tags = $ref->getCacheTags();
    // The media type's own source field first, then the field names the
    // theme checked before.
    $candidates = array_unique(array_filter([
      $ref->getSource()->getConfiguration()['source_field'] ?? NULL,
      'field_media_image',
      'field_media_thumbnail',
      'field_media_hero_image',
      'field_image',
      'image',
    ]));
    foreach ($candidates as $media_field) {
      if ($ref->hasField($media_field) && !$ref->get($media_field)->isEmpty()) {
        $media_item = $ref->get($media_field)->first();
        if ($media_item->entity instanceof FileInterface) {
          $file = $media_item->entity;
          $values = $media_item->getValue();
          $alt = (string) ($values['alt'] ?? '');
          $title = (string) ($values['title'] ?? '');
          break;
        }
      }
    }
    $title = $title ?: (string) $ref->label();
    foreach (['field_media_caption', 'field_caption'] as $caption_field) {
      if ($ref->hasField($caption_field) && !$ref->get($caption_field)->isEmpty()) {
        $caption = (string) $ref->get($caption_field)->value;
        break;
      }
    }
  }
  elseif ($ref instanceof FileInterface) {
    $file = $ref;
    $values = $item->getValue();
    $alt = (string) ($values['alt'] ?? '');
    $title = (string) ($values['title'] ?? '');
  }

  if (!$file || !$file->access('view')) {
    return NULL;
  }

  $uri = $file->getFileUri();
  $cache_tags = array_merge($cache_tags, $file->getCacheTags());
  $attributes = [
    'alt' => $alt,
    'class' => ['hero-image', 'img-fluid'],
  ];
  if ($title !== '') {
    $attributes['title'] = $title;
  }

  if (\Drupal::moduleHandler()->moduleExists('responsive_image')
    && \Drupal::entityTypeManager()->getStorage('responsive_image_style')->load(TOWNSCANADA_HERO_RESPONSIVE_STYLE)) {
    $render = [
      '#type' => 'responsive_image',
      '#responsive_image_style_id' => TOWNSCANADA_HERO_RESPONSIVE_STYLE,
      '#uri' => $uri,
      '#attributes' => $attributes,
    ];
  }
  elseif (ImageStyle::load(TOWNSCANADA_HERO_IMAGE_STYLE)) {
    $render = [
      '#theme' => 'image_style',
      '#style_name' => TOWNSCANADA_HERO_IMAGE_STYLE,
      '#uri' => $uri,
      '#attributes' => $attributes,
    ];
  }
  else {
    $render = [
      '#theme' => 'image',
      '#uri' => $uri,
      '#attributes' => $attributes,
    ];
  }

  return [
    'url' => _townscanada_image_style_url($uri),
    'responsive_render' => $render,
    'alt' => $alt,
    'title' => $title,
    'caption' => $caption,
    'cache_tags' => $cache_tags,
  ];
}

/**
 * Implements hook_preprocess_block().
 */
function townscanada_preprocess_block(array &$variables) {
  $block_content = $variables['elements']['#block_content'] ?? NULL;
  if ($block_content instanceof BlockContentInterface && $block_content->bundle() === 'hero') {
    // Hero blocks always use the parallax background.
    $variables['#attached']['library'][] = 'townscanada/hero-parallax';
  }
}

/**
 * Implements hook_preprocess_region().
 *
 * Provides validated hero_* variables to region--hero.html.twig without
 * replacing the region's blocks.
 */
function townscanada_preprocess_region(array &$variables) {
  if ($variables['region'] !== 'hero') {
    return;
  }

  $variables['hero_image_url'] = '';
  $variables['hero_image_responsive'] = NULL;
  $variables['hero_image_alt'] = '';
  $variables['hero_image_title'] = '';
  $variables['hero_image_caption'] = '';
  $variables['hero_overlay_opacity'] = '0.35';
  $variables['hero_background_color'] = '';
  $variables['hero_parallax_speed'] = '0.18';
  $variables['hero_fit'] = FALSE;
  $variables['#cache']['contexts'][] = 'url.path';

  $route_match = \Drupal::routeMatch();
  $node = $route_match->getParameter('node');

  if ($node instanceof NodeInterface) {
    $variables['#cache']['tags'][] = 'node:' . $node->id();

    foreach (TOWNSCANADA_HERO_NODE_FIELDS as $field_name) {
      if ($img = _townscanada_extract_image_from_field($node, $field_name)) {
        $variables['hero_image_url'] = $img['url'];
        $variables['hero_image_responsive'] = $img['responsive_render'];
        $variables['hero_image_alt'] = $img['alt'];
        $variables['hero_image_title'] = $img['title'];
        $variables['hero_image_caption'] = $img['caption'];
        array_push($variables['#cache']['tags'], ...$img['cache_tags']);
        break;
      }
    }

    // These values end up in a style attribute, so only accept a hex
    // colour and a number between 0 and 1.
    if ($node->hasField('field_hero_background_color') && !$node->get('field_hero_background_color')->isEmpty()) {
      $color = trim((string) $node->get('field_hero_background_color')->first()->getString());
      if (preg_match('/^#[0-9a-f]{3,8}$/i', $color)) {
        $variables['hero_background_color'] = $color;
      }
    }
    if ($node->hasField('field_hero_overlay_opacity') && !$node->get('field_hero_overlay_opacity')->isEmpty()) {
      $opacity = $node->get('field_hero_overlay_opacity')->first()->getString();
      if (is_numeric($opacity)) {
        $variables['hero_overlay_opacity'] = (string) max(0, min(1, (float) $opacity));
      }
    }
  }
  elseif ($route_match->getRouteName() === 'entity.taxonomy_term.canonical') {
    $term = $route_match->getParameter('taxonomy_term');
    if ($term instanceof TermInterface) {
      $variables['#cache']['tags'][] = 'taxonomy_term:' . $term->id();
      foreach (TOWNSCANADA_HERO_TERM_FIELDS as $field_name) {
        // Works for both image fields and media references. Term heroes
        // keep using a CSS background image, as before.
        if ($img = _townscanada_extract_image_from_field($term, $field_name)) {
          $variables['hero_image_url'] = $img['url'];
          $variables['hero_image_alt'] = $img['alt'] ?: $term->label();
          array_push($variables['#cache']['tags'], ...$img['cache_tags']);
          break;
        }
      }
    }
  }

  if (!empty($variables['hero_image_responsive']) || !empty($variables['hero_image_url'])) {
    $variables['#attached']['library'][] = 'townscanada/hero-parallax';
  }
}

/**
 * Implements hook_preprocess_HOOK() for hierarchical_taxonomy_menu.
 *
 * Menu links point to /province/town/category/subcategory...
 */
function townscanada_preprocess_hierarchical_taxonomy_menu(array &$variables) {
  if (empty($variables['menu_tree']) || !is_array($variables['menu_tree'])) {
    $variables['prefix'] = '';
    return;
  }

  $prefix = _townscanada_get_province_town_prefix();
  $variables['prefix'] = $prefix;
  $variables['#cache']['contexts'][] = 'url.path';

  // Load every term in the tree with one query instead of one per item.
  $tids = [];
  _townscanada_collect_tids($variables['menu_tree'], $tids);
  $terms = $tids
    ? \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadMultiple(array_unique($tids))
    : [];

  _townscanada_add_term_fields($variables['menu_tree'], $terms, $prefix);
}

/**
 * Returns the /province/town prefix from the current path alias.
 */
function _townscanada_get_province_town_prefix(): string {
  $current_path = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
  $segments = explode('/', trim($alias, '/'));

  // The first two segments of the alias are the province and the town.
  return count($segments) >= 2 ? '/' . $segments[0] . '/' . $segments[1] : '';
}

/**
 * Collects term IDs from a hierarchical_taxonomy_menu tree.
 */
function _townscanada_collect_tids(array $menu_tree, array &$tids): void {
  foreach ($menu_tree as $item) {
    if (isset($item['tid'])) {
      $tids[] = $item['tid'];
    }
    if (!empty($item['subitem']) && is_array($item['subitem'])) {
      _townscanada_collect_tids($item['subitem'], $tids);
    }
  }
}

/**
 * Returns the URL slug for a term name, e.g. "Food & Drink" -> "food-drink".
 *
 * Kept identical to the previous inline code so existing URLs don't change.
 * Ideally these links would use the terms' own Pathauto aliases instead.
 */
function _townscanada_term_slug(TermInterface $term): string {
  return strtolower(preg_replace('/[^\w]+/', '-', trim($term->getName())));
}

/**
 * Adds icon, colour and /province/town/... URLs to menu items.
 *
 * @param array $menu_tree
 *   The menu tree, changed in place.
 * @param \Drupal\taxonomy\TermInterface[] $terms
 *   The tree's terms, keyed by term ID.
 * @param string $prefix
 *   The /province/town prefix, or '' when not on a location page.
 * @param string $parent_path
 *   The slug path of the parent items, e.g. '/food'.
 */
function _townscanada_add_term_fields(array &$menu_tree, array $terms, string $prefix = '', string $parent_path = ''): void {
  foreach ($menu_tree as &$item) {
    // Reset per item: an item without a term must not inherit the previous
    // item's term (this used to give children the wrong parent path).
    $term = isset($item['tid']) ? ($terms[$item['tid']] ?? NULL) : NULL;
    $item_path = $parent_path;

    if ($term instanceof TermInterface) {
      foreach (['field_listing_category_icon', 'field_listing_category_color'] as $field_name) {
        if ($term->hasField($field_name) && !$term->get($field_name)->isEmpty()) {
          $item[$field_name] = $term->get($field_name)->value;
        }
      }

      $item_path = $parent_path . '/' . _townscanada_term_slug($term);
      if ($prefix !== '') {
        $item['custom_url'] = $prefix . $item_path;
      }
    }

    if (!empty($item['subitem']) && is_array($item['subitem'])) {
      _townscanada_add_term_fields($item['subitem'], $terms, $prefix, $item_path);
    }
  }
  unset($item);
}
