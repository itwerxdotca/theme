/**
 * Implements hook_preprocess_page().
 */
function townscanada_preprocess_page(array &$variables) {
  // Attach the modal library from the theme.
  // The page differs for anonymous users, so cached copies must too.
  $variables['#cache']['contexts'][] = 'user.roles:anonymous';
  if (\Drupal::currentUser()->isAnonymous()) {
    $variables['#attached']['library'][] = 'townscanada/modal-forms';
  }
}

/**
 * Implements hook_preprocess_hierarchical_taxonomy_menu().
 *
 * Menu links point to /province/town/category-alias/subcategory...
 */

 function townscanada_preprocess_hierarchical_taxonomy_menu(&$variables) {
   if (!is_array($variables['menu_tree'])) {
     return;
   }

   // Detect prefix
   $prefix = _townscanada_get_province_town_prefix();

   // Add term fields - Pass menu tree by reference
   _townscanada_add_term_fields($variables['menu_tree'], $prefix);

   $variables['prefix'] = $prefix;
 }

 /**
  * Get the /province/town prefix.
  */
 function _townscanada_get_province_town_prefix() {
   $current_path = \Drupal::service('path.current')->getPath();
   $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);

   // Parse the alias
   $segments = explode('/', trim($alias, '/'));

   // If we have at least 2 segments, assume first two are province/town
   if (count($segments) >= 2) {
     return '/' . $segments[0] . '/' . $segments[1];
   }

   return '';
 }

 /**
  * Recursively add term fields to menu items with hierarchical URLs.
  */
 function _townscanada_add_term_fields(&$menu_tree, $prefix = '', $parent_path = '') {
   $is_province_town = !empty($prefix);

   foreach ($menu_tree as &$item) {
     if (isset($item['tid'])) {
       $term = \Drupal::entityTypeManager()
         ->getStorage('taxonomy_term')
         ->load($item['tid']);

       if ($term) {
         // Add term fields
         if ($term->hasField('field_listing_category_icon') && !$term->get('field_listing_category_icon')->isEmpty()) {
           $item['field_listing_category_icon'] = $term->get('field_listing_category_icon')->value;
         }

         if ($term->hasField('field_listing_category_color') && !$term->get('field_listing_category_color')->isEmpty()) {
           $item['field_listing_category_color'] = $term->get('field_listing_category_color')->value;
         }

         if ($is_province_town) {
           // Generate slug for the current term
           $slug = strtolower(preg_replace('/[^\w]+/', '-', trim($term->getName())));

           // Build the full hierarchical path
           if (!empty($parent_path)) {
             // This is a child term, include parent in path
             $item['custom_url'] = $prefix . $parent_path . '/' . $slug;
           } else {
             // This is a top-level term
             $item['custom_url'] = $prefix . '/' . $slug;
           }
         }
       }
     }

     // If this item has children, recursively process them
     if (isset($item['subitem']) && is_array($item['subitem'])) {
       // Build the parent path for children
       $current_parent_path = '';
       if (isset($term)) {
         $current_slug = strtolower(preg_replace('/[^\w]+/', '-', trim($term->getName())));
         if (!empty($parent_path)) {
           $current_parent_path = $parent_path . '/' . $current_slug;
         } else {
           $current_parent_path = '/' . $current_slug;
         }
       }

       // Recursively process children with the updated parent path
       _townscanada_add_term_fields($item['subitem'], $prefix, $current_parent_path);
     }
   }
 }

/**
  * Implements hook_system_breadcrumb_alter().
  */
 function townscanada_system_breadcrumb_alter(&$breadcrumb, &$context) {
   // Get current path and alias
   $current_path = \Drupal::service('path.current')->getPath();
   $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);

   // Only process for location-based taxonomy pages
   // Check if alias matches pattern: /province/town/...
   if (preg_match('#^/([^/]+)/([^/]+)/(.+)$#', $alias, $matches)) {
     $province = $matches[1];
     $town = $matches[2];
     $category_path = $matches[3];

     // Create new breadcrumb
     $new_breadcrumb = new \Drupal\Core\Breadcrumb\Breadcrumb();

     // FIXED: Remove t() function
     $new_breadcrumb->addLink(\Drupal\Core\Link::createFromRoute('Home', '<front>'));

     // Add province
     $province_name = ucwords(str_replace('-', ' ', $province));
     $new_breadcrumb->addLink(\Drupal\Core\Link::createFromRoute($province_name, '<none>'));

     // Add town
     $town_name = ucwords(str_replace('-', ' ', $town));
     $new_breadcrumb->addLink(\Drupal\Core\Link::createFromRoute($town_name, '<none>'));

     // Parse hierarchical categories
     $segments = explode('/', $category_path);

     // Build links for each category segment
     foreach ($segments as $index => $segment) {
       if (empty($segment)) continue;

       $term_name = ucwords(str_replace('-', ' ', $segment));
       $new_breadcrumb->addLink(\Drupal\Core\Link::createFromRoute($term_name, '<none>'));
     }

     // Add cache contexts
     $new_breadcrumb->addCacheContexts(['url.path']);

     // Replace the breadcrumb
     $breadcrumb = $new_breadcrumb;
   }
 }

 /**
 * Implements hook_preprocess_flag().
 */
function townscanada_preprocess_flag(&$variables) {
  // Make current user object available in flag template
  $variables['current_user'] = \Drupal::currentUser();
  $variables['is_anonymous'] = $variables['current_user']->isAnonymous();

  // Add cache context so it varies per user
  $variables['#cache']['contexts'][] = 'user';
}

/**
 * Implements hook_preprocess_html().
 *
 * On a town page, or on content tagged with a town, adds
 * "has-province province-<code>" to <body>. css/style.css maps each class
 * to var(--province) and var(--province-ink).
 */
function townscanada_preprocess_html(array &$variables): void {
  $code = _townscanada_current_province_code();
  if ($code !== NULL) {
    $variables['attributes']['class'][] = 'has-province';
    $variables['attributes']['class'][] = 'province-' . $code;
  }
}

/**
 * Returns the province code (on, bc ...) for the page being viewed.
 *
 * Reads field_province_code from the town term being viewed, or from the
 * first town in a node's field_canadian_towns.
 *
 * @return string|null
 *   A two-letter province or territory code, or NULL when the page has none.
 */
function _townscanada_current_province_code(): ?string {
  $route_match = \Drupal::routeMatch();
  $town = NULL;

  $term = $route_match->getParameter('taxonomy_term');
  if ($term instanceof Term && $term->hasField('field_province_code')) {
    return _townscanada_term_province_code($term);
  }

  $node = $route_match->getParameter('node');
  if ($node instanceof NodeInterface
    && $node->hasField('field_canadian_towns')
    && !$node->get('field_canadian_towns')->isEmpty()) {
    $town = $node->get('field_canadian_towns')->entity;
  }

  return $town ? _townscanada_term_province_code($town) : NULL;
}

/**
 * Returns the known province and territory codes with their names.
 *
 * @return string[]
 *   Names keyed by the two-letter code used in field_province_code and in
 *   the .province-<code> CSS classes.
 */
function _townscanada_province_names(): array {
  return [
    'yt' => t('Yukon'),
    'nt' => t('Northwest Territories'),
    'nu' => t('Nunavut'),
    'bc' => t('British Columbia'),
    'ab' => t('Alberta'),
    'sk' => t('Saskatchewan'),
    'mb' => t('Manitoba'),
    'on' => t('Ontario'),
    'qc' => t('Quebec'),
    'nb' => t('New Brunswick'),
    'pe' => t('Prince Edward Island'),
    'ns' => t('Nova Scotia'),
    'nl' => t('Newfoundland and Labrador'),
  ];
}

/**
 * Returns the province code for any term in the towns vocabulary.
 *
 * Uses the term's own field_province_code; if it has none, the nearest
 * parent's; if none of those have one (a province term itself), matches
 * the term's name against the province names.
 */
function _townscanada_term_province_code($term): ?string {
  if (!$term || !method_exists($term, 'id')) {
    return NULL;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  // loadAllParents() returns the term itself first, then each parent up.
  foreach ($storage->loadAllParents($term->id()) as $ancestor) {
    if ($code = _townscanada_province_code_of($ancestor)) {
      return $code;
    }
  }
  $normalize = fn(string $name) => strtolower(trim(str_replace('&', 'and', $name)));
  $names = array_map(fn($n) => $normalize((string) $n), _townscanada_province_names());
  foreach ($storage->loadAllParents($term->id()) as $ancestor) {
    $code = array_search($normalize($ancestor->label()), $names, TRUE);
    if ($code !== FALSE) {
      return $code;
    }
  }
  return NULL;
}

/**
 * Returns a term's own province code, or NULL when it has no known code.
 */
function _townscanada_province_code_of($town): ?string {
  if (!$town || !$town->hasField('field_province_code') || $town->get('field_province_code')->isEmpty()) {
    return NULL;
  }
  $code = strtolower(trim((string) $town->get('field_province_code')->value));
  return isset(_townscanada_province_names()[$code]) ? $code : NULL;
}

/**
 * Implements hook_preprocess_HOOK() for taxonomy-term.html.twig.
 *
 * Gives town templates the province code and name for the town banner.
 */
function townscanada_preprocess_taxonomy_term(array &$variables): void {
  $term = $variables['term'] ?? NULL;
  $code = _townscanada_term_province_code($term);
  $variables['province_code'] = $code ?? '';

  // The province name goes above the town name, but not on a province's
  // own page: a top-level term (no parent) is the province itself.
  $is_top_level = $term
    && !\Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadParents($term->id());
  $variables['province_name'] = ($code && !$is_top_level)
    ? (string) _townscanada_province_names()[$code]
    : '';
}

/**
 * Returns which app layout a view display asked for through its CSS class.
 *
 * @return string|null
 *   'place-list' for the class "tc-place-list", 'town-tiles' for
 *   "tc-town-tiles", otherwise NULL.
 */
function _townscanada_view_app_layout($view): ?string {
  if (!is_object($view) || !isset($view->display_handler)) {
    return NULL;
  }
  $classes = preg_split('/\s+/', (string) $view->display_handler->getOption('css_class'));
  if (in_array('tc-town-tiles', $classes, TRUE)) {
    return 'town-tiles';
  }
  if (in_array('tc-place-list', $classes, TRUE)) {
    return 'place-list';
  }
  return NULL;
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for views_view_fields.
 *
 * Rows of a view display with the CSS class "tc-place-list" use
 * views-view-fields--tc-place-row.html.twig; "tc-town-tiles" uses
 * views-view-fields--tc-town-tile.html.twig.
 */
function townscanada_theme_suggestions_views_view_fields_alter(array &$suggestions, array $variables): void {
  $layout = _townscanada_view_app_layout($variables['view'] ?? NULL);
  if ($layout === 'place-list') {
    $suggestions[] = 'views_view_fields__tc_place_row';
  }
  elseif ($layout === 'town-tiles') {
    $suggestions[] = 'views_view_fields__tc_town_tile';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for views_view_unformatted.
 */
function townscanada_theme_suggestions_views_view_unformatted_alter(array &$suggestions, array $variables): void {
  if (_townscanada_view_app_layout($variables['view'] ?? NULL)) {
    $suggestions[] = 'views_view_unformatted__tc_place_list';
  }
}

/**
 * Implements hook_preprocess_HOOK() for views-view-unformatted.html.twig.
 */
function townscanada_preprocess_views_view_unformatted(array &$variables): void {
  $variables['tc_layout'] = _townscanada_view_app_layout($variables['view'] ?? NULL) ?? '';
}

/**
 * Implements hook_preprocess_HOOK() for menu--mobile-tabs.html.twig.
 *
 * Tells the tab bar when it is on the front page, so the Home tab (a link
 * to <front>) is marked current there.
 */
function townscanada_preprocess_menu__mobile_tabs(array &$variables): void {
  $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();
  $variables['#cache']['contexts'][] = 'url.path.is_front';
}
